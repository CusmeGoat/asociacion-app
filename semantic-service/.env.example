PORT=8010
DATABASE_URL=postgresql://managerice:managerice123@localhost:5432/managerice_db
EMBEDDING_MODEL=intfloat/multilingual-e5-large
VECTOR_DIMENSION=1024
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
OCR_ENABLED=true
OCR_LANGUAGE=spa
OCR_DPI=220
OCR_MIN_PAGE_CHARS=30
OCR_TESSERACT_CONFIG=--oem 1 --psm 6
OCR_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_TESSDATA_DIR=.tessdata
SEARCH_MAX_DISTANCE=0.85
SEARCH_FETCH_MULTIPLIER=4
